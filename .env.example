# Copy to .env and generate a random 32+ byte SECRET_KEY before running.
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
DATABASE_PATH=data/ncsc.sqlite3
# For local HTTP development only. Use HTTPS before any deployment.
COOKIE_HTTPS_ONLY=false

# Current K14 pilot address. The website does not open this address.
# Direct TCP probing is independent of connector file imports.
K14_HOST=192.168.254.201
K14_PORT=4370
K14_LAN_PROBE_ENABLED=false
# Automatic file imports only. Authenticated admins can still read manually.
# Enable on the approved local host after verifying a manual import.
K14_ATTENDANCE_SYNC_ENABLED=false
K14_SYNC_INTERVAL_SECONDS=60
K14_CONNECTOR_DB=%LOCALAPPDATA%\NCSC-K14-Pilot\attendance.sqlite3
